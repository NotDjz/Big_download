<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Id derives a stable UpgradeCode: never change it, or a newer MSI installs beside the old one
       instead of replacing it. Per user, because the app writes downloads\, temp_uploads\ and
       cookies.txt beside its exe: Program Files would be read-only for it. -->
  <Package Id="NotDjz.BigDownloader" Name="Big Downloader" Manufacturer="NotDjz"
           Version="$(var.Version)" Scope="perUser">
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="BigDownloader" />
      </Directory>
    </StandardDirectory>

    <!-- A per-user component needs an HKCU KeyPath and its folders removed on uninstall (ICE38,
         ICE64). RemoveFolder only removes an empty folder, so the downloads, and the folder
         holding them, survive an uninstall or an upgrade. A file plus a registry KeyPath cannot
         get a generated Guid: this one is fixed, never change it. -->
    <Component Directory="INSTALLFOLDER" Guid="092BD77D-9BC6-468D-BEDE-484A9900AD6A">
      <File Id="App" Source="dist\BigDownloader.exe" KeyPath="no">
        <Shortcut Name="Big Downloader" Directory="ProgramMenuFolder" WorkingDirectory="INSTALLFOLDER" />
      </File>
      <RegistryValue Root="HKCU" Key="Software\NotDjz\BigDownloader" Name="Installed" Type="integer"
                     Value="1" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <Icon Id="BigDownloader.ico" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="BigDownloader.ico" />
  </Package>
</Wix>
